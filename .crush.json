{
  "$schema": "https://charm.land/crush.json",
  "models": {
    "large": {
      "model": "glm-5.2",
      "provider": "zhipu-coding"
    }
  },
  "permissions": {
    "allowed_tools": [
      "view",
      "ls",
      "grep",
      "glob"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "name": "harness-write-guard",
        "command": "python3 .crush/hooks/guard.py",
        "timeout": 15
      }
    ]
  }
}
