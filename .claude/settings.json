{
  "permissions": {
    "allow": [
      "Bash(git --no-pager:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git commit:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git stash:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(golangci-lint run:*)"
    ],
    "deny": [],
    "ask": []
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "go -C \"${CLAUDE_PROJECT_DIR}\" run ./scripts/cmd/alint_hook",
            "timeout": 300,
            "statusMessage": "Linting the file just written"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": false
  }
}
