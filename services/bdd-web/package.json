{
  "name": "true-bdd-harness",
  "version": "0.1.0",
  "private": true,
  "description": "TrueBDD web harness: a stateless Next.js relay + UI between the true-bdd CLI (remote agent) and the browser, coordinated through Redis.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev -p 4517",
    "build": "next build",
    "start": "node server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "ioredis": "^5.4.1",
    "next": "15.5.22",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.5.22",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
