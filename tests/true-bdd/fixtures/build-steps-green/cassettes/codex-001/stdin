package steps

import (
	"bytes"
	"fmt"
	"os/exec"
	"strconv"
	"strings"
)

func phrasefd1683cb9efb040dcb9ff323bbe5d2d3e9f958d39b3e3e7eafcb136f94b8a9df(state *State, args []string) error {
	const hostRoot = "../.."

	value := strconv.Itoa(state.Value)

	cmd := exec.Command("go", "run", "./services/calc", "double", value)
	cmd.Dir = hostRoot

	var stdout, stderr bytes.Buffer
	cmd.Stdout = &stdout
	cmd.Stderr = &stderr

	if err := cmd.Run(); err != nil {
		return fmt.Errorf("double %s: %w: %s", value, err, strings.TrimSpace(stderr.String()))
	}

	printed := strings.TrimSpace(stdout.String())

	doubled, err := strconv.Atoi(printed)
	if err != nil {
		return fmt.Errorf("double %s printed %q: %w", value, printed, err)
	}

	state.Value = doubled

	return nil
}
