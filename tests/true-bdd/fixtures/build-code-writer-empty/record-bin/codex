#!/bin/sh
set -eu
mkdir -p ./tmp
request=$(mktemp ./tmp/codex-request.XXXXXX)
trap 'rm -f "$request"' EXIT
answer_file=''
previous=''
for argument in "$@"; do
  if [ "$previous" = '-o' ]; then answer_file=$argument; fi
  previous=$argument
done
cat > "$request"
"${TRUE_BDD_RECORD_CODEX:?Set to the installed codex path}" "$@" < "$request" || exit "$?"
if grep -q 'Fixture transport outcome: empty output' "$request"; then
  test -n "$answer_file"
  : > "$answer_file"
  exit 0
fi
if grep -q 'Fixture transport outcome: non-zero exit' "$request"; then exit 7; fi
