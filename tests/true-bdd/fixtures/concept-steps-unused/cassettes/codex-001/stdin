```go
package steps

import (
	"fmt"
	"os/exec"
	"strconv"
	"strings"
)

//truebdd:concept when "halving"
func conceptec8b881314b929394828fe6c21c7db729a95bc1a93ad8abf8ec578b93a9e83f2(state *State, args []string) error {
	const (
		hostRoot = "../.."
		pkgPath  = "./services/calc"
		command  = "halve"
	)
	number := args[0]
	cmd := exec.Command("go", "run", pkgPath, command, number)
	cmd.Dir = hostRoot
	var stdout, stderr strings.Builder
	cmd.Stdout = &stdout
	cmd.Stderr = &stderr
	if err := cmd.Run(); err != nil {
		return fmt.Errorf("run %s %s %s: %w: %s", pkgPath, command, number, err, strings.TrimSpace(stderr.String()))
	}
	printed := strings.TrimSpace(stdout.String())
	halved, err := strconv.Atoi(printed)
	if err != nil {
		return fmt.Errorf("%s %s printed %q, not an integer: %w", command, number, printed, err)
	}
	state.Result = halved
	return nil
}
```

Notes for the applier:

- `exec.Command` is given the captured number verbatim; `go run` passes every argument after the package path to the program, so a leading minus sign such as `-7` reaches the command as its `value` argument unchanged.
- `cmd.Run()` with explicit `Stdout`/`Stderr` builders is used rather than `cmd.Output()`, because `Output()` rejects a command whose `Stderr` is already set; stderr is captured only to make a non-zero exit (`'1': Invalid arguments`) readable in the failure message.
- Nothing else in the suite changes: the Then step `^the result is (-?\d+)$` in `definitions.go` already compares `state.Result` with the expected value, so this When step only has to record what the process printed.

