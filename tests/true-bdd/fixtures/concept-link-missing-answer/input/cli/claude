#!/usr/bin/env python3
"""Schema-breaking replies only; these cases cannot come from a real model."""
import json
import pathlib
import sys

case = json.loads((pathlib.Path.cwd() / "link-case.json").read_text())
kind = case["answer"]
if kind == "missing":
    envelope = {"result": ""}
elif kind == "malformed":
    envelope = {"structured_output": {"steps": []}}
elif kind == "incomplete":
    schema = json.loads(sys.argv[sys.argv.index("--json-schema") + 1])
    answer = {}
    for key, step in schema["properties"]["steps"]["properties"].items():
        scores = {name: 10 for name in step["properties"]["scores"]["required"]}
        scores.pop(case["omit"], None)
        answer[key] = {"scores": scores, "reason": "Deliberately incomplete.", "other_block_concept": None}
    envelope = {"structured_output": {"steps": answer}}
else:
    raise ValueError("Only invalid replies are sanctioned")
print(json.dumps(dict(type="result", subtype="success", is_error=False, total_cost_usd=0, **envelope)))
