### 1. New file: `tests/calc/helpers/calc.go`

Create the directory `tests/calc/helpers/` (beside `tests/calc/steps/`) with this exact content:

```go
package helpers

import (
	"fmt"
	"os"
	"os/exec"
	"path/filepath"
	"strconv"
	"strings"
)

// CalcCommand is the Go package of the calculator CLI, relative to the host
// root, as the declared public interface states it.
const CalcCommand = "./services/calc"

// HostRoot returns the host root the declared CLI runs from: the nearest
// ancestor of the test working directory that holds the module's go.mod.
func HostRoot() (string, error) {
	dir, err := os.Getwd()
	if err != nil {
		return "", fmt.Errorf("working directory: %w", err)
	}
	for {
		if _, statErr := os.Stat(filepath.Join(dir, "go.mod")); statErr == nil {
			return dir, nil
		}
		parent := filepath.Dir(dir)
		if parent == dir {
			return "", fmt.Errorf("host root with go.mod not found above the test working directory")
		}
		dir = parent
	}
}

// RunCalc runs the declared calculator command as a process from the host
// root with the given arguments and returns its stdout unchanged.
func RunCalc(args ...string) (string, error) {
	root, err := HostRoot()
	if err != nil {
		return "", err
	}
	argv := append([]string{"run", CalcCommand}, args...)
	cmd := exec.Command("go", argv...)
	cmd.Dir = root
	var stdout, stderr strings.Builder
	cmd.Stdout = &stdout
	cmd.Stderr = &stderr
	if runErr := cmd.Run(); runErr != nil {
		return "", fmt.Errorf("go %s in %s: %w: %s",
			strings.Join(argv, " "), root, runErr, strings.TrimSpace(stderr.String()))
	}
	return stdout.String(), nil
}

// Halve runs the declared halve command with value as its argument and
// returns the integer the command wrote on stdout. The value is passed
// through as the step captured it; the integer comes only from the
// command's own stdout.
func Halve(value string) (int, error) {
	out, err := RunCalc("halve", value)
	if err != nil {
		return 0, err
	}
	text := strings.TrimSpace(out)
	halved, err := strconv.Atoi(text)
	if err != nil {
		return 0, fmt.Errorf("halve %s: stdout %q is not an integer", value, text)
	}
	return halved, nil
}
```

Notes for the applier: `exec.Command` inherits the process environment, so the inherited Go build cache and temporary-directory settings are preserved. Do not add a separate `GOCACHE`/`GOTMPDIR`.

