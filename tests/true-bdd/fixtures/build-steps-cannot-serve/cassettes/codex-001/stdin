```go
package steps

import (
	"bytes"
	"fmt"
	"os"
	"os/exec"
	"path/filepath"
	"strconv"
	"strings"
)

//truebdd:concept when "halving"
func concept13b4354efb42d97fb2de7c428a7011995700d0f26a06ebb3f9c6eb1c150d5f87(state *State, args []string) error {
	value, err := strconv.Atoi(args[0])
	if err != nil {
		return fmt.Errorf("whole number %q: %w", args[0], err)
	}

	root, err := os.Getwd()
	if err != nil {
		return fmt.Errorf("working directory: %w", err)
	}
	for {
		if _, statErr := os.Stat(filepath.Join(root, "go.mod")); statErr == nil {
			break
		}
		parent := filepath.Dir(root)
		if parent == root {
			return fmt.Errorf("host root with go.mod not found above the test working directory")
		}
		root = parent
	}

	cmd := exec.Command("go", "run", "./services/calc", "halve", strconv.Itoa(value))
	cmd.Dir = root
	cmd.Env = os.Environ()
	var stdout, stderr bytes.Buffer
	cmd.Stdout = &stdout
	cmd.Stderr = &stderr
	if runErr := cmd.Run(); runErr != nil {
		return fmt.Errorf("halve %d: %w: %s", value, runErr, strings.TrimSpace(stderr.String()))
	}

	halved, err := strconv.Atoi(strings.TrimSpace(stdout.String()))
	if err != nil {
		return fmt.Errorf("halve %d stdout %q is not an integer: %w", value, stdout.String(), err)
	}
	state.Result = halved
	return nil
}
```

Why this body, clause by clause of the binding's `does`:
- "Run the declared halve command as a process" — `exec.Command("go", "run", "./services/calc", "halve", ...)` with `cmd.Dir` set to the host root, exactly the invocation the interface document's `halve.description` declares. The root is found by walking up from the test working directory to the directory holding `go.mod`, so the step does not hard-code `../..`.
- "with the step's whole number" — `args[0]` (the pattern's single capture `(-?\d+)`, positive, zero or negative) is parsed with `strconv.Atoi` and passed back as the command's required integer `value` argument.
- "and keep its integer stdout as the result" — on exit 0 the trimmed stdout (the interface declares "integer and a newline") is parsed with `strconv.Atoi` and stored in `state.Result`; nothing is computed about halving or rounding in the step, the process's own stdout is the only source of the value.
- A non-zero exit (the interface's `'1'` response) fails the step with the command's stderr, rather than leaving a stale `state.Result`.

