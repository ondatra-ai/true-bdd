package steps

import (
	"bytes"
	"context"
	"fmt"
	"os/exec"
	"strconv"
	"strings"
	"time"
)

//truebdd:concept when "halving"
func concept13b4354efb42d97fb2de7c428a7011995700d0f26a06ebb3f9c6eb1c150d5f87(state *State, args []string) error {
	// docs/architecture/calc-cli.yaml declares halve as
	// `go run ./services/calc halve VALUE`, run from the host root; a Go
	// test runs in its own package directory, tests/calc, two levels down.
	const (
		hostRoot = "../.."
		timeout  = 2 * time.Minute
	)

	number, err := strconv.Atoi(args[0])
	if err != nil {
		return fmt.Errorf("the Owner halves %q: not a whole number: %w", args[0], err)
	}

	ctx, cancel := context.WithTimeout(context.Background(), timeout)
	defer cancel()

	argv := []string{"go", "run", "./services/calc", "halve", strconv.Itoa(number)}

	var stdout, stderr bytes.Buffer

	cmd := exec.CommandContext(ctx, argv[0], argv[1:]...)
	cmd.Dir = hostRoot
	cmd.Stdout = &stdout
	cmd.Stderr = &stderr

	err = cmd.Run()
	if err != nil {
		return fmt.Errorf("%s: %w: %s", strings.Join(argv, " "), err, strings.TrimSpace(stderr.String()))
	}

	halved, err := strconv.Atoi(strings.TrimSpace(stdout.String()))
	if err != nil {
		return fmt.Errorf("%s: stdout %q is not an integer: %w",
			strings.Join(argv, " "), stdout.String(), err)
	}

	state.Result = halved

	return nil
}
```

## Why this is the body

- **When, not Then.** The body only invokes the declared operation and records what the process said. The halved number is never computed here: `state.Result` is whatever the `halve` process printed on stdout, parsed as an integer. The comparison with `3` / `-3` stays in the already-written `then "result"` definition.
- **The one capture.** The pattern `^the Owner halves (-?\d+)$` yields a single capture, so `args[0]` is the step's whole number (`6`, `-7`). `strconv.Atoi` validates it as a whole number — positive, zero or negative, per the glossary — and `strconv.Itoa(number)` passes it back as the command's canonical `value` argument, which the interface types as `integer`.
- **The declared invocation.** `argv` is literally the command string the interface document declares, and `cmd.Dir = "../.."` is the host root as seen from the suite's package directory `tests/calc`, which is where `go test` runs this binary. The environment is inherited (no `cmd.Env`), which `go run` needs.
- **Failure is reported, not interpreted.** A non-zero exit (the interface's `'1': Invalid arguments`) or a failure to start surfaces through `cmd.Run()`'s error together with the trimmed stderr, so the scenario fails on the step that acted rather than on a later assertion. The trailing newline the interface promises is removed with `strings.TrimSpace` before parsing.
- **Scope.** `hostRoot` and `timeout` are local constants inside the selected function body; the only change outside the braces is this file's import block.

