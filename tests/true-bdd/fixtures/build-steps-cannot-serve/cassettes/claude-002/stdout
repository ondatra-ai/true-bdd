 Required. The\n97\t// constructor receives the World (scenario + *testing.T), so teardown\n98\t// registered via w.T.Cleanup gets LIFO ordering against later steps.\n99\tfunc (s *Suite[S]) Init(newState func(*World) (*S, error)) {\n100\t\ts.newState = newState\n101\t}\n102\t\n103\t// Step binds a regexp to the code that executes a matching step. The\n104\t// pattern's capture groups become the step's arguments, in order.\n105\t// Anchoring (`^…$`) is the caller's business — unanchored quietly over-matches.\n106\tfunc (s *Suite[S]) Step(pattern string, run func(*S, []string) error) {\n107\t\tcompiled, err := regexp.Compile(pattern)\n108\t\tif err != nil {\n109\t\t\tif s.err == nil {\n110\t\t\t\ts.err = fmt.Errorf(\"bddgo: step pattern %q: %w\", pattern, err)\n111\t\t\t}\n112\t\n113\t\t\treturn\n114\t\t}\n115\t\n116\t\ts.steps = append(s.steps, stepDef[S]{pattern: compiled, run: run})\n117\t}\n118\t\n119\t// all returns every scenario in the registry, parsed once per process.\n120\tfunc (s *Suite[S]) all() ([]Scenario, error) {\n121\t\ts.loadOnce.Do(func() {\n122\t\t\ts.loaded, s.loadErr = LoadRegistry(s.opts.Registry)\n123\t\t})\n124\t\n125\t\treturn s.loaded, s.loadErr\n126\t}\n127\t\n128\t// Owned returns the registry scenarios this suite owns, in id order. An\n129\t// empty result is not an error here — whether that's a bug is\n130\t// CheckCoverage's question to ask (see ErrNoScenariosForSuite).\n131\tfunc (s *Suite[S]) Owned() ([]Scenario, error) {\n132\t\tall, err := s.all()\n133\t\tif err != nil {\n134\t\t\treturn nil, err\n135\t\t}\n136\t\n137\t\towned := make([]Scenario, 0, len(all))\n138\t\n139\t\tfor _, scenario := range all {\n140\t\t\tif s.spec.Owns(scenario) {\n141\t\t\t\towned = append(owned, scenario)\n142\t\t\t}\n143\t\t}\n144\t\n145\t\treturn owned, nil\n146\t}\n147\t\n148\t// Lookup returns the registry scenario with the given id, whether or not\n149\t// this suite owns it. The second result reports whether it was found.\n150\tfunc (s *Suite[S]) L