      "text": "FROM node:22-alpine\n\nWORKDIR /app\n\nENV NEXT_TELEMETRY_DISABLED=1\n\nCOPY package.json ./\nRUN npm install --no-audit --no-fund\n\nCOPY . .\nRUN npm run build\n\nENV NODE_ENV=production\nENV PORT=3000\nENV HOSTNAME=0.0.0.0\n\nEXPOSE 3000\n\nCMD [\"npm\", \"run\", \"start\"]\n"
