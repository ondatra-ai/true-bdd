      "size": 105,
      "sha256": "524524977819f80b247eb85bc54868ad310bf381ac65892baeccea8200471915",
      "text": "export default function HomePage() {\n  return (\n    \u003cmain\u003e\n      \u003ch1\u003eHello world\u003c/h1\u003e\n    \u003c/main\u003e\n  );\n}\n"
