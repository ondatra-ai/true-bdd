### Change 1 — create the shared helper package

Create the file `tests/calc/helpers/calc.go` with exactly this content:

```go
// Package helpers holds the code the calc suite's step definitions share:
// how the declared calculator CLI is invoked and how its stdout is read.
//
// The calculator alone decides any halved number. Nothing here computes a
// result; these helpers only carry a step's argument into the declared
// process and carry the integer it prints back out.
package helpers

import (
	"errors"
	"fmt"
	"os"
	"os/exec"
	"path/filepath"
	"strconv"
	"strings"
)

// ServicePath is the calculator's package path as the declared CLI states
// it: `go run ./services/calc <command> ...`, run from the host root.
const ServicePath = "./services/calc"

// HostRoot returns the directory the declared calculator commands run
// from: the nearest ancestor of the working directory (starting with the
// working directory itself) that holds the calculator's service path. A
// suite's tests run in their own package directory, so the host root is
// found by walking up rather than by a fixed relative path.
func HostRoot() (string, error) {
	dir, err := os.Getwd()
	if err != nil {
		return "", err
	}
	start := dir
	for {
		if info, err := os.Stat(filepath.Join(dir, filepath.FromSlash(ServicePath))); err == nil && info.IsDir() {
			return dir, nil
		}
		parent := filepath.Dir(dir)
		if parent == dir {
			return "", fmt.Errorf("host root holding %s not found at or above %s", ServicePath, start)
		}
		dir = parent
	}
}

// RunCalc runs the declared calculator CLI as a process from the host root
// with args (the command name first, then its arguments) and returns what
// the process wrote to stdout, trimmed of its trailing newline.
func RunCalc(args ...string) (string, error) {
	root, err := HostRoot()
	if err != nil {
		return "", err
	}
	argv := append([]string{"run", ServicePath}, args...)
	cmd := exec.Command("go", argv...)
	cmd.Dir = root
	out, err := cmd.Output()
	if err != nil {
		var exit *exec.ExitError
		if errors.As(err, &exit) {
			if stderr := strings.TrimSpace(string(exit.Stderr)); stderr != "" {
				return "", fmt.Errorf("calculator %s failed: %w: %s", strings.Join(args, " "), err, stderr)
			}
		}
		return "", fmt.Errorf("calculator %s failed: %w", strings.Join(args, " "), err)
	}
	return strings.TrimSpace(string(out)), nil
}

// Halve runs the declared halve command with value, the step's whole
// number as written, and returns the integer the calculator printed on
// stdout. The halving itself is the calculator's, never this helper's.
func Halve(value string) (int, error) {
	printed, err := RunCalc("halve", value)
	if err != nil {
		return 0, err
	}
	halved, err := strconv.Atoi(printed)
	if err != nil {
		return 0, fmt.Errorf("halve %s printed %q on stdout, not an integer", value, printed)
	}
	return halved, nil
}
```

