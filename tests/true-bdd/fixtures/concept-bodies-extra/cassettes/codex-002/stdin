### 3. Create `tests/calc/helpers/calc.go` (new file)

```go
// Package helpers runs the calculator's declared command-line interface
// for the calc suite's steps. It only starts the process and reads what
// the process printed; it never computes a calculator answer itself.
package helpers

import (
	"errors"
	"fmt"
	"os/exec"
	"strconv"
	"strings"
)

// hostRoot is the directory the declared CLI is run from, relative to the
// suite's test working directory (tests/calc). The interface document
// states the command as `go run ./services/calc halve VALUE` from the
// host root.
const hostRoot = "../.."

// RunHalve runs the declared halve command as a process with value as its
// single argument and returns the integer the command printed on stdout.
// Nothing beyond the declared value argument is required or supplied.
func RunHalve(value string) (int, error) {
	stdout, err := runCalc("halve", value)
	if err != nil {
		return 0, err
	}
	return parseInteger(stdout)
}

// runCalc starts the calculator command with the given arguments and
// returns its stdout.
func runCalc(args ...string) (string, error) {
	command := append([]string{"run", "./services/calc"}, args...)
	cmd := exec.Command("go", command...)
	cmd.Dir = hostRoot
	stdout, err := cmd.Output()
	if err != nil {
		var exitErr *exec.ExitError
		if errors.As(err, &exitErr) {
			return "", fmt.Errorf("go %s: %w: %s", strings.Join(command, " "), err, strings.TrimSpace(string(exitErr.Stderr)))
		}
		return "", fmt.Errorf("go %s: %w", strings.Join(command, " "), err)
	}
	return string(stdout), nil
}

// parseInteger reads the command's stdout as a single integer.
func parseInteger(stdout string) (int, error) {
	text := strings.TrimSpace(stdout)
	number, err := strconv.Atoi(text)
	if err != nil {
		return 0, fmt.Errorf("the calculator printed %q, which is not an integer", text)
	}
	return number, nil
}
```

