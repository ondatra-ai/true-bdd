```go
package steps

import (
	"fmt"
	"os/exec"
	"strconv"
	"strings"
)

//truebdd:concept when "halving"
func concept8c83e3012dd37395db8aad8a8fafef5f14ca67ae936908b0e63bff4b60526148(state *State, args []string) error {
	const (
		hostRoot    = "../.."
		packagePath = "./services/calc"
		commandName = "halve"
	)
	if len(args) < 1 {
		return fmt.Errorf("%s: expected the whole number capture, got %d captures", commandName, len(args))
	}
	value, err := strconv.Atoi(args[0])
	if err != nil {
		return fmt.Errorf("%s: the whole number %q is not an integer: %w", commandName, args[0], err)
	}
	cmd := exec.Command("go", "run", packagePath, commandName, strconv.Itoa(value))
	cmd.Dir = hostRoot
	var stderr strings.Builder
	cmd.Stderr = &stderr
	stdout, err := cmd.Output()
	if err != nil {
		return fmt.Errorf("go run %s %s %d in %s: %w: %s", packagePath, commandName, value, hostRoot, err, strings.TrimSpace(stderr.String()))
	}
	halved, err := strconv.Atoi(strings.TrimSpace(string(stdout)))
	if err != nil {
		return fmt.Errorf("%s: stdout %q is not an integer: %w", commandName, strings.TrimSpace(string(stdout)), err)
	}
	state.Result = halved
	return nil
}
```

## Why this body

- The binding says: run the declared `halve` command as a process with the step's whole number and keep its integer stdout as the result. The body does exactly that and never computes the halving itself — `state.Result` is only ever whatever the process printed.
- The Public interface document (`docs/architecture/calc-cli.yaml`) declares the invocation as `go run ./services/calc halve VALUE` from the host root, with stdout being the halved integer plus a newline, so the body builds that argv, sets `cmd.Dir` to the host root, and trims the trailing newline before `strconv.Atoi`.
- `cmd.Dir = "../.."` matches the `../../docs/...` paths already used by `tests/calc/scenarios/scenarios.go`, which resolve relative to `tests/calc` where the generated test runs; `../..` is therefore the host root.
- The whole number capture is parsed with `strconv.Atoi` and re-rendered with `strconv.Itoa` so the step text and the process argument agree on one canonical integer form, and a malformed capture fails the step rather than reaching the product.
- Exit status 1 is declared as "Invalid arguments", so a non-zero exit is reported as a step error with the captured stderr instead of being silently turned into a result.
- All constants are local to the function body; no package-level constants, variables, helpers or types are added. The only change outside the body is this file's import block.

