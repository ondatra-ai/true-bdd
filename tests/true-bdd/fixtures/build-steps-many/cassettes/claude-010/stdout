{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Nd9gfZGtGVz9VP64wx3vAc","type":"tool_result","content":"1\tpackage bddgo\n2\t\n3\timport (\n4\t\t\"errors\"\n5\t\t\"fmt\"\n6\t\t\"regexp\"\n7\t\t\"strings\"\n8\t\t\"sync\"\n9\t\t\"testing\"\n10\t)\n11\t\n12\t// ErrNoScenariosForSuite signals that the registry has scenarios but\n13\t// none the named suite owns — refused because a suite that runs nothing\n14\t// passes trivially, indistinguishable from a bug that looks like success.\n15\tvar ErrNoScenariosForSuite = errors.New(\"no registry scenario names this suite's service\")\n16\t\n17\t// ErrAmbiguousStep signals a step matched by more than one definition.\n18\t// Refused rather than resolved by registration order, which would make\n19\t// behavior depend on line order in a file nobody reads for that.\n20\tvar ErrAmbiguousStep = errors.New(\"step matches more than one definition\")\n21\t\n22\t// AmbiguousStepError is the ambiguity resolve found, with its three\n23\t// parts kept apart so a caller can render them itself.\n24\ttype AmbiguousStepError struct {\n25\t\tScenario string\n26\t\tStep     string\n27\t\tPatterns []string\n28\t}\n29\t\n30\tfunc (e *AmbiguousStepError) Error() string {\n31\t\treturn fmt.Sprintf(\"%s: %q: %v (%s)\",\n32\t\t\te.Scenario, e.Step, ErrAmbiguousStep, strings.Join(e.Patterns, \" | \"))\n33\t}\n34\t\n35\t// Unwrap lets errors.Is reach the sentinel, which is what tells a caller\n36\t// this is a finding about a step rather than the suite failing to answer.\n37\tfunc (e *AmbiguousStepError) Unwrap() error { return ErrAmbiguousStep }\n38\t\n39\t// Options configures one suite run.\n40\ttype Options struct {\n41\t\t// Registry is the scenario registry's path — `documents.scenarios_yaml`\n42\t\t// from the host's true-bdd.yaml, conventionally docs/scenarios.yaml.\n43\t\tRegistry string\n44\t\t// Architecture is the architectural spec's path.\n45\t\tArchitecture string\n46\t\t// Suite names the `architecture.testing