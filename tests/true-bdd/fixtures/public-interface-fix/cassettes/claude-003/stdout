{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Bq9CGGkVhLYU6QV5GMRzcT","type":"tool_result","content":"1\t# Yamale schema for the architectural spec (path from\n2\t# `documents.architecture_yaml` in true-bdd.yaml, conventionally\n3\t# docs/architecture/architecture.yaml).\n4\t#\n5\t# The filename is not free: the schema gate pairs\n6\t# `true-bdd/<key>-schema.yaml` with `documents.<key>`, and the key is\n7\t# `architecture_yaml`. A file named `architecture-schema.yaml` would\n8\t# resolve no document and fail the gate rather than validate anything.\n9\t#\n10\t#   yamale -s true-bdd/architecture_yaml-schema.yaml docs/architecture/architecture.yaml\n11\t#\n12\t# The engine decodes only `testing:`, `services[].{name,path,language,writable,libraries,public_interface}`\n13\t# and, for closure checks, `terms:` and `phrases:`; everything else here is\n14\t# spec a host writes for its own readers and for the checklists' prompts.\n15\t# Which is exactly why it needs a schema: nothing else would notice a typo\n16\t# in it.\n17\t#\n18\t# Yamale is strict by default — an unlisted key is an error — so a host\n19\t# adding a block to its architectural spec adds it here too.\n20\t\n21\tarchitecture: include('architecture')\n22\t# No `vocabulary:` here: the product document holds it and its catalogue,\n23\t# which `us refine` cites; this document maps words (`terms:`) and phrases (`phrases:`).\n24\t\n25\t---\n26\t# One `testing:` section for the whole repository, beside the services it\n27\t# exercises: it says how the tests run, once. Which service a test belongs\n28\t# to and which file it lives in are the scenario's, not a suite's.\n29\tarchitecture:\n30\t  testing: include('testing')\n31\t  services: list(include('service'), min=1)\n32\t  terms: list(include('term_mapping'), required=False)\n33\t  phrases: list(include('phrase_mapping'), required=False)\n34\t  prompt_data: map(include('prompt_data'), required=False)\n35\t\n36\t---\n37\t# How one product glossary word turns into the implementation, and how a\n38\t# step definition sets it up or observes it, in words, never a Go name.\n39\tterm_mapping:\n40\t  term: str()\n41\t  technical: str()\n42\t  observed_by: str()\n43\t\n44\t---\n45\t# How this repository's tests run. `framework` routes to a runner and\n46\t# decides what `build tests` renders; `commands` is how each mode is\n47\t# invoked. Declaring neither describes a project nothing can build.\n48\ttesting:\n49\t  libraries: list(include('library'), required=False)\n50\t  framework: enum('go-test', 'jest', 'playwright')\n51\t  # Framework config file. Its containing directory is the working\n52\t  # directory every command runs in; without one they run from wherever\n53\t  # the engine was invoked.\n54\t  config: str(required=False)\n55\t  commands: include('commands')\n56\t\n57\t---\n58\tlibrary:\n59\t  module: str()\n60\t  version: str(matches='^v[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?(\\+incompatible)?$')\n61\t\n62\t---\n63\tservice:\n64\t  libraries: list(include('library'), required=False)\n65\t  name: str()\n66\t  path: str()\n67\t  # Exact project-relative files or folders; no patterns or test overlap.\n68\t  writable: list(str(), required=False)\n69\t  public_interface: include('public_interface', required=False)\n70\t  language: str()\n71\t  # Free-form classification (`cli`, `web:frontend`, `service`, …). Not\n72\t  # a closed vocabulary: nothing in the engine branches on it.\n73\t  type: str(required=False)\n74\t  frameworks: list(str(), required=False)\n75\t  dependencies: list(include('dependency'), required=False)\n76\t  patterns: map(include('pattern'), required=False)\n77\t  design_system: include('design_system', required=False)\n78\t  # Non-test gates a host runs against this service (linters, type\n79\t  # checkers). Declared for its own readers; the engine reads none of it.\n80\t  quality_gate: include('quality_gate', required=False)\n81\t\n82\t---\n83\t# What a service talks to at runtime. `scope` decides how a build treats\n84\t# it: self_hosted gets the real thing, third_party gets mocked\n85\t# (record/replay), internal is another service in this same document.\n86\tdependency:\n87\t  name: str()\n88\t  protocol: str()\n89\t  scope: enum('internal', 'self_hosted', 'third_party')\n90\t  # How the service spawns a `protocol: cli` dependency, when a rebuild must\n91\t  # send exactly the same request: replay hashes argv and stdin.\n92\t  invocation: include('invocation', required=False)\n93\t\n94\t---\n95\t# One spawn of a CLI dependency, stated byte for byte. A `{name}` token\n96\t# anywhere in it stands for the entry `values` defines under that name.\n97\tinvocation:\n98\t  # The executable, found on PATH. A cassette records it as `binary`.\n99\t  binary: str()\n100\t  # Every argument after the binary, in order. A cassette records them as\n101\t  # `argv`. A map entry is a run of arguments sent only when `when` holds.\n102\t  args: list(any(str(), include('conditional_args')), min=1)\n103\t  # What the child reads on stdin, then EOF. `with_system` applies when the\n104\t  # turn has a system prompt, `without_system` when it has none. Absent when\n105\t  # the child reads nothing there (its prompts travel in argv).\n106\t  stdin: include('stdin', required=False)\n107\t  # What each `{name}` token stands for.\n108\t  values: map(str(), min=1)\n109\t  # The child's working directory.\n110\t  dir: str()\n111\t  # Environment entries set on top of the inherited environment.\n112\t  env: map(str(), required=False)\n113\t  # Facts about the binary that shaped this invocation.\n114\t  notes: list(str(), required=False)\n115\t\n116\t---\n117\tconditional_args:\n118\t  when: str()\n119\t  args: list(str(), min=1)\n120\t\n121\t---\n122\tstdin:\n123\t  with_system: str()\n124\t  without_system: str()\n125\t\n126\t---\n127\tpattern:\n128\t  description: str()\n129\t  rules: list(str(), min=1)\n130\t\n131\t---\n132\tdesign_system:\n133\t  path: str()\