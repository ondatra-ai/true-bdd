uct glossary word turns into the implementation, and how a\n38\t# step definition sets it up or observes it, in words, never a Go name.\n39\tterm_mapping:\n40\t  term: str()\n41\t  technical: str()\n42\t  observed_by: str()\n43\t\n44\t---\n45\t# How this repository's tests run. `framework` routes to a runner and\n46\t# decides what `build tests` renders; `commands` is how each mode is\n47\t# invoked. Declaring neither describes a project nothing can build.\n48\ttesting:\n49\t  libraries: list(include('library'), required=False)\n50\t  framework: enum('go-test', 'jest', 'playwright')\n51\t  # Framework config file. Its containing directory is the working\n52\t  # directory every command runs in; without one they run from wherever\n53\t  # the engine was invoked.\n54\t  config: str(required=False)\n55\t  commands: include('commands')\n56\t\n57\t---\n58\tlibrary:\n59\t  module: str()\n60\t  version: str(matches='^v[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?(\\+incompatible)?$')\n61\t\n62\t---\n63\tservice:\n64\t  libraries: list(include('library'), required=False)\n65\t  name: str()\n66\t  path: str()\n67\t  # Exact project-relative files or folders; no patterns or test overlap.\n68\t  writable: list(str(), required=False)\n69\t  public_interface: include('public_interface', required=False)\n70\t  language: str()\n71\t  # Free-form classification (`cli`, `web:frontend`, `service`, …). Not\n72\t  # a closed vocabulary: nothing in the engine branches on it.\n73\t  type: str(required=False)\n74\t  frameworks: list(str(), required=False)\n75\t  dependencies: list(include('dependency'), required=False)\n76\t  patterns: map(include('pattern'), required=False)\n77\t  design_system: include('design_system', required=False)\n78\t  # Non-test gates a host runs against this service (linters, type\n79\t  # checkers). Declared for its own readers; the engine reads none of it.\n80\t  quality_gate: include('quality_gate', required=False)\n81\t\n82\t---\n83\t# What a service talks to a