finition could assert belongs in one.\n33\t\n34\tmetadata: include('metadata')\n35\t# A key is its lineage id `<story-id>-<NNN>-<slug>` (ADR 0014), e.g.\n36\t# `scen-check-001-unknown-id-refused`; the retired `E2E-NNN` stays valid\n37\t# until each Story renames its Scenarios.\n38\tscenarios: map(include('scenario'), key=regex('^(E2E-[0-9]{3}|[a-z0-9][a-z0-9.-]*-[0-9]{3}-[a-z0-9]+(-[a-z0-9]+)*)$'), min=1)\n39\t\n40\t---\n41\tmetadata:\n42\t  title: str()\n43\t  version: str()\n44\t  description: str()\n45\t  last_updated: str(required=False)\n46\t\n47\t---\n48\tscenario:\n49\t  # One sentence naming the behaviour, free of the words the product\n50\t  # document's `vocabulary:` forbids. The generated test carries it as the\n51\t  # comment above its function.\n52\t  description: str()\n53\t  # Must name a service declared in architecture.yaml. It is also the\n54\t  # join that decides which tests own the scenario: they live in\n55\t  # `tests/<service>/`, mirroring `services/<service>/`.\n56\t  service: str()\n57\t  # Generated test file this scenario is written into, repo-relative.\n58\t  # Several scenarios may share one file (emitted in id order). Required,\n59\t  # never defaulted — grouping is editorial judgement no generator should guess.\n60\t  path: str()\n61\t  # Free-form note on where the behaviour comes from. Optional.\n62\t  requirement: str(required=False)\n63\t  # Optional grouping label for a human reader; the engine never reads it.\n64\t  feature: str(required=False)\n65\t  last_updated: str(required=False)\n66\t  # Lineage back to the stories this scenario was merged from, written\n67\t  # by `us apply`. An empty list is valid and says so on the record: the\n68\t  # scenario exists and no story claims it yet.\n69\t  user_stories: list(include('user_story'))\n70\t  # How long the scenario's run may take, as a Go duration (\"10m\"); absent\n71\t  # means the suite's default. Not a step (a machine's speed isn't\n72\t  # behaviour) — an invalid duration