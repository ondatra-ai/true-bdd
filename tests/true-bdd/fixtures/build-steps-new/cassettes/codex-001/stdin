No shared `State` change is needed: the suite's `State.Value` already carries the number, and the existing `result` Then step observes `State.Value`, so this When writes the command's integer stdout back into that field (the Word mapping declares `number` as "the integer argument and stdout of the calculator double command").

Replace the whole file with:

```go
package steps

import (
	"bytes"
	"fmt"
	"os/exec"
	"strconv"
	"strings"
)

func phrasefd1683cb9efb040dcb9ff323bbe5d2d3e9f958d39b3e3e7eafcb136f94b8a9df(state *State, args []string) error {
	const (
		hostRoot    = "../.."
		servicePath = "./services/calc"
		command     = "double"
	)

	value := strconv.Itoa(state.Value)

	cmd := exec.Command("go", "run", servicePath, command, value)
	cmd.Dir = hostRoot

	var stdout, stderr bytes.Buffer
	cmd.Stdout = &stdout
	cmd.Stderr = &stderr

	if err := cmd.Run(); err != nil {
		return fmt.Errorf("run %s %s %s: %w: %s", servicePath, command, value, err, stderr.String())
	}

	doubled, err := strconv.Atoi(strings.TrimSpace(stdout.String()))
	if err != nil {
		return fmt.Errorf("parse %s stdout %q: %w", command, stdout.String(), err)
	}

	state.Value = doubled

	return nil
}
```

