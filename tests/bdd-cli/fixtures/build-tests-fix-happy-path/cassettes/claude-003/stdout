s accepting connections on it before any When step relies on it.\n101\tfunc (s *State) serverIsRunning(portArg string) error {\n102\t\tport, source, err := resolvePort(portArg)\n103\t\tif err != nil {\n104\t\t\treturn err\n105\t\t}\n106\t\n107\t\taddr := net.JoinHostPort(\"127.0.0.1\", strconv.Itoa(port))\n108\t\tconn, err := net.DialTimeout(\"tcp\", addr, dialTimeout)\n109\t\tif err != nil {\n110\t\t\treturn fmt.Errorf(\n111\t\t\t\t\"expected the MCP server to be listening on %s (port from %s), but dialling it failed within %s: %v\",\n112\t\t\t\taddr, source, dialTimeout, err)\n113\t\t}\n114\t\t_ = conn.Close()\n115\t\n116\t\ts.Port = port\n117\t\ts.PortSource = source\n118\t\ts.BaseURL = \"http://\" + addr\n119\t\ts.Status = 0\n120\t\ts.Body = nil\n121\t\ts.LastRequest = \"\"\n122\t\treturn nil\n123\t}\n124\t\n125\t// resolvePort prefers a port named in the step text, then the environment,\n126\t// then the default, and says which it used.\n127\tfunc resolvePort(portArg string) (port int, source string, err error) {\n128\t\tif portArg != \"\" {\n129\t\t\tport, err = parsePort(portArg)\n130\t\t\tif err != nil {\n131\t\t\t\treturn 0, \"\", fmt.Errorf(\"expected the port in the step text to be a number in 1..65535, got %q\", portArg)\n132\t\t\t}\n133\t\t\treturn port, \"the step text\", nil\n134\t\t}\n135\t\n136\t\traw, ok := os.LookupEnv(portEnvVar)\n137\t\tif !ok || strings.TrimSpace(raw) == \"\" {\n138\t\t\treturn defaultPort, fmt.Sprintf(\"the default configured port (%s is unset)\", portEnvVar), nil\n139\t\t}\n140\t\tport, err = parsePort(raw)\n141\t\tif err != nil {\n142\t\t\treturn 0, \"\", fmt.Errorf(\"expected %s to hold a port number in 1..65535, got %q\", portEnvVar, raw)\n143\t\t}\n144\t\treturn port, portEnvVar, nil\n145\t}\n146\t\n147\tfunc parsePort(raw string) (int, error) {\n148\t\tport, err := strconv.Atoi(strings.TrimSpace(raw))\n149\t\tif err != nil {\n150\t\t\treturn 0, err\n151\t\t}\n152\t\tif port < 1 || port > 65535 {\n153\t\t\treturn 0, fmt.E