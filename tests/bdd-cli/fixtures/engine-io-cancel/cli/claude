#!/usr/bin/env python3
import os
import signal
import time
pid = os.fork()
if pid == 0:
    signal.signal(signal.SIGTERM, signal.SIG_IGN)
    with open("tmp/descendant.pending", "w", encoding="ascii") as handle:
        handle.write(str(os.getpid()))
    os.rename("tmp/descendant.pending", "tmp/descendant.pid")
    time.sleep(60)
    os._exit(0)
os.waitpid(pid, 0)
