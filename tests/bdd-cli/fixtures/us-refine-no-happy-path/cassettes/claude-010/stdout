/jest.config.ts\n            helpers:\n              - name: McpClient\n                description: \"Typed JSON-RPC client that posts requests to the MCP endpoint and returns parsed responses\"\n          e2e:\n            path: tests/e2e\n            framework: playwright\n            config: tests/playwright.config.ts\n            helpers:\n              - name: chatPage\n                description: \"Playwright fixture that opens the Claude chat UI, submits a prompt, and reads the rendered reply\"\n      dependencies: []\n\n# BDD scenario vocabulary (folded from the retired terms.yaml).\n# Read by the us-refine vague-word and forbidden-verb prompts.\nvocabulary:\n  # Allowed action verbs with their concrete meaning.\n  actions:\n    - name: \"ask Claude\"\n      means: \"write a prompt in Claude chat\"\n    - name: \"navigates to <page>\"\n      means: \"opens or browses to a specific page in the web app\"\n\n  # Vague words that must not appear in AC descriptions or steps.\n  # Checked by the us-refine acceptance_criteria vague-word prompts.\n  forbidden_qualifiers:\n    - properly\n    - correctly\n    - appropriate\n    - appropriately\n    - user-friendly\n    - fast\n    - quickly\n    - easily\n    - seamless\n    - intuitive\n\n  # Action verbs too abstract to automate: they hide the interaction\n  # mechanism. Checked by the us-refine forbidden-verb prompt.\n  forbidden_actions:\n    - name: \"handle\"\n      reason: \"Hides what the system observably does with the input.\"\n      replacement: \"Name the observable action: displays, returns, lists, rejects.\"\n    - name: \"process\"\n      reason: \"Does not specify the interaction mechanism or the visible outcome.\"\n      replacement: \"Name the observable action: displays, returns, lists, rejects.\"\n    - name: \"parse\"\n      reason: \"Describes internal mechanics, not user-observable behavior.\"\n      replacement: \"Describe the visible result of reading the input.\"\n","numLines":70,"startLine":1,"totalLines":70}}}
