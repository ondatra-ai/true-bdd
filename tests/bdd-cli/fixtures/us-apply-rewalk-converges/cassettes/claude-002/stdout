finition could assert belongs in one.\n33\t\n34\tmetadata: include('metadata')\n35\tscenarios: map(include('scenario'), min=1)\n36\t\n37\t---\n38\tmetadata:\n39\t  title: str()\n40\t  version: str()\n41\t  description: str()\n42\t  last_updated: str(required=False)\n43\t\n44\t---\n45\tscenario:\n46\t  # One sentence naming the behaviour, in the product document's action\n47\t  # vocabulary. What a reader sees first in `build tests` output and in\n48\t  # the run report.\n49\t  description: str()\n50\t  # Must name a service declared in architecture.yaml. It is also the\n51\t  # join that decides which tests own the scenario: they live in\n52\t  # `tests/<service>/`, mirroring `services/<service>/`.\n53\t  service: str()\n54\t  # Generated test file this scenario is written into, repo-relative.\n55\t  # Several scenarios may share one file (emitted in id order). Required,\n56\t  # never defaulted — grouping is editorial judgement no generator should guess.\n57\t  path: str()\n58\t  # Free-form note on where the behaviour comes from. Optional.\n59\t  requirement: str(required=False)\n60\t  # Optional grouping label. Read by the workspace UI, never by the\n61\t  # engine.\n62\t  feature: str(required=False)\n63\t  last_updated: str(required=False)\n64\t  # Lineage back to the stories this scenario was merged from, written\n65\t  # by `us apply`. An empty list is valid and says so on the record: the\n66\t  # scenario exists and no story claims it yet.\n67\t  user_stories: list(include('user_story'))\n68\t  # How long the scenario's run may take, as a Go duration (\"10m\"); absent\n69\t  # means the suite's default. Not a step (a machine's speed isn't\n70\t  # behaviour) — an invalid duration is refused, not rounded up to default.\n71\t  timeout: str(required=False)\n72\t  merged_steps: include('merged_steps')\n73\t\n74\t---\n75\tuser_story:\n76\t  story: str()\n77\t  scenario_id: str()\n78\t  merge_date: str(required=False)\n79\t\n80\t---\n81\t# All three blocks are opt