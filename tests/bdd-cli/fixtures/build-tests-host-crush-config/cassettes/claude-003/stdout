{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019vvKhic9kqLmwYrp8mvwBD","type":"tool_result","content":"1\t//go:build bdd\n2\t\n3\t// Step definitions for the `mcp` suite.\n4\t//\n5\t// The suite that owns scenario INT-900 is rooted at tests/mcp per\n6\t// docs/architecture/architecture.yaml, so every definition for its\n7\t// scenarios is registered from this package.\n8\t//\n9\t// Shape of the package:\n10\t//\n11\t//   - State is the suite's shared state: one HTTP client, the resolved\n12\t//     base URL of the server under test, and whatever the last request\n13\t//     came back with. Every definition reads and writes it through the\n14\t//     closure Register hands out, so Given can prepare for a When and a\n15\t//     Then can report on what actually happened.\n16\t//   - Patterns are anchored and parameterised. Where a scenario's wording\n17\t//     varies — the actor, the service name, the JSON-RPC method, the\n18\t//     request path, the expected status code — there is a capture group,\n19\t//     so one definition serves every scenario phrased that way.\n20\tpackage steps\n21\t\n22\timport (\n23\t\t\"bytes\"\n24\t\t\"encoding/json\"\n25\t\t\"fmt\"\n26\t\t\"io\"\n27\t\t\"net\"\n28\t\t\"net/http\"\n29\t\t\"net/url\"\n30\t\t\"os\"\n31\t\t\"strconv\"\n32\t\t\"strings\"\n33\t\t\"time\"\n34\t)\n35\t\n36\t// Suite is the registration surface the BDD harness hands to Register.\n37\t// It is an interface so the harness's own suite type satisfies it\n38\t// structurally, without this package having to import the harness.\n39\ttype Suite interface {\n40\t\tStep(pattern string, fn interface{})\n41\t}\n42\t\n43\t// State is the state shared by every definition in this suite.\n44\ttype State struct {\n45\t\tClient  *http.Client\n46\t\tService string // service named by the Given step, for error messages\n47\t\tBaseURL string // e.g. \"http://127.0.0.1:8080\", no trailing slash\n48\t\n49\t\tLastMethod string // JSON-RPC method of the last request sent\n50\t\tLastPath   string // request path of the last request sent\n51\t\tLastStatus int    // 0 until a response has been received\n52\t\tLastBody   []byte\n53\t}\n54\t\n55\tconst (\n56\t\tdefaultHost    = \"127.0.0.1\"\n57\t\tdefaultPort    = \"8080\"\n58\t\tdialTimeout    = 5 * time.Second\n59\t\trequestTimeout = 10 * time.Second\n60\t)\n61\t\n62\t// resolveBaseURL derives the address of the server under test from the\n63\t// environment: MCP_BASE_URL wins, otherwise MCP_PORT on localhost,\n64\t// otherwise the default port. \"its configured port\" in the scenario text\n65\t// is exactly this configuration.\n66\tfunc resolveBaseURL() (string, error) {\n67\t\tif raw := strings.TrimSpace(os.Getenv(\"MCP_BASE_URL\")); raw != \"\" {\n68\t\t\tu, err := url.Parse(raw)\n69\t\t\tif err != nil {\n70\t\t\t\treturn \"\", fmt.Errorf(\"expected MCP_BASE_URL to be a URL like http://127.0.0.1:8080, got %q: %w\", raw, err)\n71\t\t\t}\n72\t\t\tif u.Scheme == \"\" || u.Host == \"\" {\n73\t\t\t\treturn \"\", fmt.Errorf(\"expected MCP_BASE_URL to be a URL like http://127.0.0.1:8080, got %q\", raw)\n74\t\t\t}\n75\t\t\treturn strings.TrimRight(raw, \"/\"), nil\n76\t\t}\n77\t\n78\t\tport := strings.TrimSpace(os.Getenv(\"MCP_PORT\"))\n79\t\tif port == \"\" {\n80\t\t\tport = defaultPort\n81\t\t}\n82\t\tif _, err := strconv.Atoi(port); err != nil {\n83\t\t\treturn \"\", fmt.Errorf(\"expected MCP_PORT to be a port number, got %q\", port)\n84\t\t}\n85\t\treturn \"http://\" + net.JoinHostPort(defaultHost, port), nil\n86\t}\n87\t\n88\t// hostPort returns the dialable host:port of a base URL, filling in the\n89\t// scheme's default port when the URL omits one.\n90\tfunc hostPort(base string) (string, error) {\n91\t\tu, err := url.Parse(base)\n92\t\tif err != nil {\n93\t\t\treturn \"\", fmt.Errorf(\"expected a parsable base URL, got %q: %w\", base, err)\n94\t\t}\n95\t\tif u.Host == \"\" {\n96\t\t\treturn \"\", fmt.Errorf(\"expected a base URL with a host, got %q\", base)\n97\t\t}\n98\t\tif u.Port() != \"\" {\n99\t\t\treturn u.Host, nil\n100\t\t}\n101\t\tif u.Scheme == \"https\" {\n102\t\t\treturn net.JoinHostPort(u.Hostname(), \"443\"), nil\n103\t\t}\n104\t\treturn net.JoinHostPort(u.Hostname(), \"80\"), nil\n105\t}\n106\t\n107\t// waitReachable blocks until something accepts TCP connections at addr, or\n108\t// the timeout runs out.\n109\tfunc waitReachable(addr string, timeout time.Duration) error {\n110\t\tdeadline := time.Now().Add(timeout)\n111\t\tvar last error\n112\t\tfor {\n113\t\t\tconn, err := net.DialTimeout(\"tcp\", addr, 500*time.Millisecond)\n114\t\t\tif err == nil {\n115\t\t\t\t_ = conn.Close()\n116\t\t\t\treturn nil\n117\t\t\t}\n118\t\t\tlast = err\n119\t\t\tif !time.Now().Before(deadline) {\n120\t\t\t\treturn fmt.Errorf(\"expected something listening on %s within %s, but dialling it kept failing: %w\", addr, timeout, last)\n121\t\t\t}\n122\t\t\ttime.Sleep(100 * time.Millisecond)\n123\t\t}\n124\t}\n125\t\n126\t// jsonRPCParams returns a well-formed params object for the given\n127\t// JSON-RPC method, so \"a valid ... request\" is actually valid.\n128\tfunc jsonRPCParams(method string) map[string]interface{} {\n129\t\tswitch method {\n130\t\tcase \"initialize\":\n131\t\t\treturn map[string]interface{}{\n132\t\t\t\t\"protocolVersion\": \"2025-06-18\",\n133\t\t\t\t\"capabilities\":    map[string]interface{}{},\n134\t\t\t\t\"clientInfo\": map[string]interface{}{\n135\t\t\t\t\t\"name\":    \"true-bdd-suite\",\n136\t\t\t\t\t\"version\": \"1.0.0\",\n137\t\t\t\t},\n138\t\t\t}\n139\t\tdefault:\n140\t\t\treturn map[string]interface{}{}\n141\t\t}\n142\t}\n143\t\n144\t// post sends a JSON body to path on the state's base URL and records the\n145\t// outcome on the state.\n146\tfunc (s *State) post(path string, payload interface{}) error {\n147\t\tbody, err := json.Marshal(payload)\n148\t\tif err != nil {\n149\t\t\treturn fmt.Errorf(\"expected the request body to encode as JSON, but encoding failed: %w\", err)\n150\t\t}\n151\t\tif !strings.