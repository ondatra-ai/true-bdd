{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017sxBSzKQixddsfVyNN6mFK","type":"tool_result","content":"1\tpackage steps\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"fmt\"\n6\t\t\"io\"\n7\t\t\"net/http\"\n8\t\t\"os\"\n9\t\t\"regexp\"\n10\t\t\"strings\"\n11\t\t\"time\"\n12\t)\n13\t\n14\t// defaultMCPPort is the port the MCP server listens on when MCP_PORT is unset.\n15\tconst defaultMCPPort = \"7411\"\n16\t\n17\t// healthTimeout bounds how long \"the MCP server is running\" waits for readiness.\n18\tconst healthTimeout = 5 * time.Second\n19\t\n20\t// healthPollInterval paces the readiness poll.\n21\tconst healthPollInterval = 50 * time.Millisecond\n22\t\n23\t// initializeRequest is the JSON-RPC 2.0 request that opens a session.\n24\tconst initializeRequest = `{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\"}`\n25\t\n26\t// ticketPattern is the shape of a granted ticket: 32 lowercase hex characters.\n27\tvar ticketPattern = regexp.MustCompile(`^[0-9a-f]{32}$`)\n28\t\n29\t// protocolPattern is the shape of a named protocol version: a YYYY-MM-DD date.\n30\tvar protocolPattern = regexp.MustCompile(`^\\d{4}-\\d{2}-\\d{2}$`)\n31\t\n32\t// Register binds this suite's step vocabulary to its definitions.\n33\tfunc Register(suite Suite) {\n34\t\tsuite.Step(`^the MCP server is running$`, givenMCPServerIsRunning)\n35\t\tsuite.Step(`^the (.+) opens a session$`, whenActorOpensASession)\n36\t\tsuite.Step(`^the session is granted a ticket$`, thenSessionIsGrantedATicket)\n37\t\tsuite.Step(`^the server names its protocol version$`, thenServerNamesItsProtocolVersion)\n38\t}\n39\t\n40\t// serverBaseURL resolves the MCP server's address from MCP_PORT, falling back\n41\t// to the default port when the variable is unset.\n42\tfunc serverBaseURL() string {\n43\t\tport := strings.TrimSpace(os.Getenv(\"MCP_PORT\"))\n44\t\tif port == \"\" {\n45\t\t\tport = defaultMCPPort\n46\t\t}\n47\t\n48\t\treturn \"http://127.0.0.1:\" + port\n49\t}\n50\t\n51\t// httpClient ret