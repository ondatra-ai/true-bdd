n\tresp, err := client.Do(req)\n\tif err != nil {\n\t\treturn 0, fmt.Errorf(\"GET %s/healthz failed: %w\", addr, err)\n\t}\n\tdefer func() { _ = resp.Body.Close() }()\n\n\t_, _ = io.Copy(io.Discard, resp.Body)\n\n\treturn resp.StatusCode, nil\n}\n\n// openSession POSTs the initialize request to /mcp and keeps the reply's\n// status code and headers.\nfunc openSession(addr string) (*Reply, error) {\n\tctx, cancel := context.WithTimeout(context.Background(), openSessionTimeout)\n\tdefer cancel()\n\n\treq, err := http.NewRequestWithContext(\n\t\tctx, http.MethodPost, addr+\"/mcp\", strings.NewReader(initializeRequest),\n\t)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"building POST %s/mcp: %w\", addr, err)\n\t}\n\n\treq.Header.Set(\"Content-Type\", \"application/json\")\n\n\tresp, err := http.DefaultClient.Do(req)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"POST %s/mcp with %s failed: %w\", addr, initializeRequest, err)\n\t}\n\tdefer func() { _ = resp.Body.Close() }()\n\n\t_, _ = io.Copy(io.Discard, resp.Body)\n\n\treturn &Reply{Status: resp.StatusCode, Header: resp.Header.Clone()}, nil\n}\n```\n\n### Change #2: the suite's `Register` function and its four step definitions\n\n**File:** `tests/mcp/steps/steps.go`\n**Action:** Use the **Write** tool (new file).\n**Content:**\n```go\npackage steps\n\nimport (\n\t\"fmt\"\n\t\"net/http\"\n\t\"regexp\"\n\t\"time\"\n)\n\nconst (\n\tticketHeader   = \"X-Session-Ticket\"\n\tprotocolHeader = \"X-MCP-Protocol\"\n\n\t// ticketPattern and protocolLayout are the architecture's shapes for\n\t// the two headers of the session's opening.\n\tticketPattern  = `^[0-9a-f]{32}$`\n\tprotocolLayout = \"2006-01-02\"\n)\n\n// Suite is what a step definition is registered with: the runner, which\n// matches a step's text and calls the definition with the pattern's\n// capture groups.\ntype Suite interface {\n\tStep(pattern string, fn func(state *State, args []string) error)\n}\n\n// Register binds every step of the `mcp` suite; one call