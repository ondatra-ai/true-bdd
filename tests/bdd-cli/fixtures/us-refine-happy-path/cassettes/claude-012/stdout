{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BRALfJki3SU4Y8gUuQcnQn","type":"tool_result","content":"1\t# Architectural spec for the us-refine BDD fixtures (shared).\n2\t#\n3\t# Read by the us-refine acceptance_criteria test-sketch prompt, which\n4\t# must discover the test framework and helpers HERE (never from code).\n5\t# Declares one integration layer (jest + McpClient) and one e2e layer\n6\t# (playwright + chatPage) so every conversation-level AC has an obvious\n7\t# home for a runnable sketch.\n8\t\n9\tarchitecture:\n10\t  services:\n11\t    - name: mcp-service\n12\t      path: services/mcp\n13\t      language: go\n14\t      frameworks:\n15\t        - net/http\n16\t      quality_gate:\n17\t        tests:\n18\t          integration:\n19\t            path: tests/integration\n20\t            framework: jest\n21\t            config: tests/jest.config.ts\n22\t            helpers:\n23\t              - name: McpClient\n24\t                description: \"Typed JSON-RPC client that posts requests to the MCP endpoint and returns parsed responses\"\n25\t          e2e:\n26\t            path: tests/e2e\n27\t            framework: playwright\n28\t            config: tests/playwright.config.ts\n29\t            helpers:\n30\t              - name: chatPage\n31\t                description: \"Playwright fixture that opens the Claude chat UI, submits a prompt, and reads the rendered reply\"\n32\t      dependencies: []\n33\t\n34\t# BDD scenario vocabulary (folded from the retired terms.yaml).\n35\t# Read by the us-refine vague-word and forbidden-verb prompts.\n36\tvocabulary:\n37\t  # Allowed action verbs with their concrete meaning.\n38\t  actions:\n39\t    - name: \"ask Claude\"\n40\t      means: \"write a prompt in Claude chat\"\n41\t    - name: \"navigates to <page>\"\n42\t      means: \"opens or browses to a specific page in the web app\"\n43\t\n44\t  # Vague words that must not appear in AC descriptions or steps.\n45\t  # Checked by the us-refine acceptance_criteria vague-word prompts.\n46\t  forbidden_qualifiers:\n47\t    - properly\n48\t    - correctly\n49\t    - appropriate\n50\t    - appropriately\n51\t    - user-friendly\n52\t    - fast\n53\t    - quickly\n54\t    - easily\n55\t    - seamless\n56\t    - intuitive\n57\t\n58\t  # Action verbs too abstract to automate: they hide the interaction\n59\t  # mechanism. Checked by the us-refine forbidden-verb prompt.\n60\t  forbidden_actions:\n61\t    - name: \"handle\"\n62\t      reason: \"Hides what the system observably does with the input.\"\n63\t      replacement: \"Name the observable action: displays, returns, lists, rejects.\"\n64\t    - name: \"process\"\n65\t      reason: \"Does not specify the interaction mechanism or the visible outcome.\"\n66\t      replacement: \"Name the observable action: displays, returns, lists, rejects.\"\n67\t    - name: \"parse\"\n68\t      reason: \"Describes internal mechanics, not user-observable behavior.\"\n69\t      replacement: \"Describe the visible result of reading the input.\"\n70\t"}]},"parent_tool_use_id":null,"session_id":"d7cd0dfd-9bc5-468b-9b7e-5164349defe2","uuid":"2f16949b-9f89-4ad6-8732-b2f255cf2e3d","timestamp":"2026-08-15T15:04:49.328Z","tool_use_result":{"type":"text","file":{"filePath":"./docs/architecture/architecture.yaml","content":"# Architectural spec for the us-refine BDD fixtures (shared).\n#\n# Read by the us-refine acceptance_criteria test-sketch prompt, which\n# must discover the test framework and helpers HERE (never from code).\n# Declares one integration layer (jest + McpClient) and one e2e layer\n# (playwright + chatPage) so every conversation-level AC has an obvious\n# home for a runnable sketch.\n\narchitecture:\n  services:\n    - name: mcp-service\n      path: services/mcp\n      language: go\n      frameworks:\n        - net/http\n      quality_gate:\n        tests:\n          integration:\n            path: tests/integration\n            framework: jest\n            config: tests/jest.config.ts\n            helpers:\n              - name: McpClient\n                description: \"Typed JSON-RPC client that posts requests to the MCP endpoint and returns parsed responses\"\n          e2e:\n            path: tests/e2e\n            framework: playwright\n            config: tests/playwright.config.ts\n            helpers:\n              - name: chatPage\n                description: \"Playwright fixture that opens the Claude chat UI, submits a prompt, and reads the rendered reply\"\n      dependencies: []\n\n# BDD scenario vocabulary (folded from the retired terms.yaml).\n# Read by the us-refine vague-word and forbidden-verb prompts.\nvocabulary:\n  # Allowed action verbs with their concrete meaning.\n  actions:\n    - name: \"ask Claude\"\n      means: \"write a prompt in Claude chat\"\n    - name: \"navigates to <page>\"\n      means: \"opens or browses to a specific page in the web app\"\n\n  # Vague words that must not appear in AC descriptions or steps.\n  # Checked by the us-refine acceptance_criteria vague-word prompts.\n  forbidden_qualifiers:\n    - properly\n    - correctly\n    - appropriate\n    - appropriately\n    - user-friendly\n    - fast\n    - quickly\n    - easily\n    - seamless\n    - intuitive\n\n  # Action verbs too abstract to automate: they hide the interaction\n  # mechanism. Checked by the us-refine forbidden-verb prompt.\n  forbidden_actions:\n    - name: \"handle\"\n      reason: \"Hides what the system observably does with the input.\"\n      replacement: \"Name the observable action: displays, returns, lists, rejects.\"\n    - name: \"process\"\n      reason: \"Does not specify the interaction mechanism or the visible outcome.\"\n      replacement: \"Name the observable action: displays, returns, lists, rejects.\"\n    - name: \"parse\"\n      reason: \"Describes internal mechanics, not user-observable behavior.\"\n      replacement: \"Describe the visible result of reading the input.\"\n","numLines":70,"startLine":1,"totalLines":70}}}
