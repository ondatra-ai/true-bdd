most recent response.\n56\t\tBody []byte\n57\t}\n58\t\n59\t// NewState returns the state a single scenario run starts from.\n60\tfunc NewState() *State {\n61\t\treturn &State{Client: &http.Client{Timeout: requestTimeout}}\n62\t}\n63\t\n64\t// StepFunc is the signature of every step definition in this suite: the\n65\t// scenario's state, plus the capture groups of the regexp that matched,\n66\t// in order.\n67\ttype StepFunc func(st *State, args ...string) error\n68\t\n69\ttype definition struct {\n70\t\tpattern *regexp.Regexp\n71\t\tfn      StepFunc\n72\t}\n73\t\n74\t// Suite is this package's registry of step definitions.\n75\ttype Suite struct {\n76\t\tdefs []definition\n77\t}\n78\t\n79\t// Step registers one definition. The pattern must be anchored with ^…$.\n80\tfunc (s *Suite) Step(pattern string, fn StepFunc) {\n81\t\ts.defs = append(s.defs, definition{pattern: regexp.MustCompile(pattern), fn: fn})\n82\t}\n83\t\n84\t// NewSuite returns a Suite with every definition of this package\n85\t// registered.\n86\tfunc NewSuite() *Suite {\n87\t\ts := &Suite{}\n88\t\tRegister(s)\n89\t\treturn s\n90\t}\n91\t\n92\t// Run executes the one definition whose regexp matches text — the step's\n93\t// text with the Given/When/Then/And keyword already stripped. Matching\n94\t// none, or more than one, is the step being unbound or ambiguous, and\n95\t// either is reported as such rather than guessed at.\n96\tfunc (s *Suite) Run(st *State, text string) error {\n97\t\tvar (\n98\t\t\targs     []string\n99\t\t\tchosen   StepFunc\n100\t\t\tpatterns []string\n101\t\t)\n102\t\tfor _, d := range s.defs {\n103\t\t\tm := d.pattern.FindStringSubmatch(text)\n104\t\t\tif m == nil {\n105\t\t\t\tcontinue\n106\t\t\t}\n107\t\t\tpatterns = append(patterns, d.pattern.String())\n108\t\t\targs = m[1:]\n109\t\t\tchosen = d.fn\n110\t\t}\n111\t\tswitch len(patterns) {\n112\t\tcase 0:\n113\t\t\treturn fmt.Errorf(\"expected step %q to match one definition in tests/mcp/steps, got none\", text)\n114\t\tcase 