case 1:\n\t\treturn found, args, nil\n\tdefault:\n\t\treturn nil, nil, fmt.Errorf(\"step %q is ambiguous: %d definitions match it (%v); exactly one must\", text, len(hits), hits)\n\t}\n}\n\n// Run resolves text and executes it against w.\nfunc (s *Suite) Run(w *World, text string) error {\n\tfn, args, err := s.Resolve(text)\n\tif err != nil {\n\t\treturn err\n\t}\n\treturn fn(w, args)\n}\n```\n\n### Change #2: register and implement the three step definitions\n\n**File:** `tests/mcp/steps/steps.go`\n**Action:** Use the **Write** tool (new file).\n\n`Register` here is the suite's single call site — every definition the\nmcp suite binds is listed in this one function. A later cycle adding a\ndefinition appends one `s.Step(...)` line to it and does **not** create a\nsecond `Register`.\n\n**Content:**\n\n```go\n//go:build bdd\n\npackage steps\n\nimport (\n\t\"bytes\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"io\"\n\t\"net\"\n\t\"net/http\"\n\t\"os\"\n\t\"strconv\"\n\t\"strings\"\n\t\"time\"\n)\n\n// defaultPort is used when nothing in the environment configures one.\nconst defaultPort = 8080\n\n// dialTimeout bounds the Given's wait for the server to accept a connection.\nconst dialTimeout = 5 * time.Second\n\n// requestTimeout bounds a single HTTP request.\nconst requestTimeout = 10 * time.Second\n\n// Register binds this suite's whole step vocabulary. Every definition the\n// mcp suite knows is listed here, exactly once.\nfunc Register(s *Suite) {\n\ts.Step(`^the (.+) server is running on its configured port$`, givenServerRunning)\n\ts.Step(`^the (.+) posts a valid JSON-RPC ([\\w./-]+) request to (/\\S*)$`, whenPostsJSONRPC)\n\ts.Step(`^the server returns HTTP (\\d{3})$`, thenServerReturnsStatus)\n}\n\n// givenServerRunning resolves the named server's configured port and\n// proves something is accepting connections on it before the scenario\n// acts. It never assumes success: if nothing is listening, the scenario\n// fails here with the address it tried, rather than later