plication/json, text/event-stream\")\n\n\tclient := &http.Client{Timeout: requestTimeout}\n\tresp, err := client.Do(req)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"expected POST %s to return a response, but the request failed: %v\", url, err)\n\t}\n\tdefer func() { _ = resp.Body.Close() }()\n\n\traw, err := io.ReadAll(resp.Body)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"expected to read the response body of POST %s, but reading it failed: %v\", url, err)\n\t}\n\n\tw.Requested = true\n\tw.LastPath = path\n\tw.LastStatus = resp.StatusCode\n\tw.LastBody = string(raw)\n\treturn nil\n}\n\n// thenServerReturnsStatus asserts the recorded status matches the one the\n// scenario named, and on failure reports both it and the body, because\n// that message is the whole of what a reader gets.\nfunc thenServerReturnsStatus(w *World, args []string) error {\n\twant, err := strconv.Atoi(args[0])\n\tif err != nil {\n\t\treturn fmt.Errorf(\"the scenario asked for HTTP %q, which is not a status code: %v\", args[0], err)\n\t}\n\n\tif !w.Requested {\n\t\treturn fmt.Errorf(\"expected HTTP %d, but the scenario has not sent a request yet\", want)\n\t}\n\n\tif w.LastStatus != want {\n\t\treturn fmt.Errorf(\"expected POST %s to return HTTP %d, got HTTP %d; response body: %s\",\n\t\t\tw.LastPath, want, w.LastStatus, bodySnippet(w.LastBody))\n\t}\n\treturn nil\n}\n\n// jsonRPCParams returns the params that make a request for method valid.\n// `initialize` is the one method with a required shape; anything else\n// gets an empty object until a scenario needs more.\nfunc jsonRPCParams(method string) map[string]any {\n\tif method != \"initialize\" {\n\t\treturn map[string]any{}\n\t}\n\treturn map[string]any{\n\t\t\"protocolVersion\": \"2025-06-18\",\n\t\t\"capabilities\":    map[string]any{},\n\t\t\"clientInfo\": map[string]any{\n\t\t\t\"name\":    \"true-bdd-suite\",\n\t\t\t\"version\": \"1.0.0\",\n\t\t},\n\t}\n}\n\n// configuredPort resolves the port the named server is configured on:\n// <NAME>_PORT, else PORT, else defaultPort.\nfunc configuredPort(name string) (int, error) {\n\tfor _, key := range []string{envPrefix(name) + \"_PORT\", \"PORT\"} {\n\t\traw, ok := os.LookupEnv(key)\n\t\tif !ok || strings.TrimSpace(raw) == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\ttrimmed := strings.TrimSpace(raw)\n\t\tport, err := strconv.Atoi(trimmed)\n\t\tif err != nil || port < 1 || port > 65535 {\n\t\t\treturn 0, fmt.Errorf(\"expected %s to hold a port number in 1..65535, got %q\", key, raw)\n\t\t}\n\t\treturn port, nil\n\t}\n\treturn defaultPort, nil\n}\n\n// envPrefix turns a server name as a scenario words it (\"MCP\", \"Claude\n// gateway\") into an environment-variable prefix (\"MCP\", \"CLAUDE_GATEWAY\").\nfunc envPrefix(name string) string {\n\tvar b strings.Builder\n\tfor _, r := range strings.ToUpper(strings.TrimSpace(name)) {\n\t\tswitch {\n\t\tcase r >= 'A' && r <= 'Z', r >= '0' && r <= '9':\n\t\t\tb.WriteRune(r)\n\t\tdefault:\n\t\t\tb.WriteByte('_')\n\t\t}\n\t}\n\treturn b.String()\n}\n\n// bodySnippet keeps a response body short enough to read in a failure\n// message while still showing what came back.\nfunc bodySnippet(body string) string {\n\tconst max = 300\n\ttrimmed := strings.TrimSpace(body)\n\tif trimmed == \"\" {\n\t\treturn \"<empty>\"\n\t}\n\tif len(trimmed) > max {\n\t\treturn trimmed[:max] + \"…(truncated)\"\n\t}\n\treturn trimmed\n}\n```\n\n## Constraints the applier must honour\n\n- Write **only** `tests/mcp/steps/suite.go` and `tests/mcp/steps/steps.go`.\n  Create the `tests/mcp/steps/` directory as part of writing them.\n- Do **not** modify `docs/scenarios.yaml`, `docs/architecture/architecture.yaml`,\n  `tests/mcp/mcp_test.go`, `go.mod`, or anything under `true-bdd/`.\n- Do **not** create `tests/mcp/scenarios/` — it is outside the permitted\n  tree, even though `mcp_test.go` imports it.\n- There is no pre-existing definition to weaken or duplicate; both files\n  are new, so use Write rather than Edit.\n\n## Verification after applying\n\nAll