ration per Registry step wording, all of them listed\n// by Register.\npackage steps\n\nimport (\n\t\"bytes\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"net\"\n\t\"net/http\"\n\t\"os\"\n\t\"strconv\"\n\t\"time\"\n)\n\nconst (\n\tportEnvVar     = \"MCP_PORT\"\n\tdefaultPort    = 8080\n\tdialTimeout    = 200 * time.Millisecond\n\tbootTimeout    = 5 * time.Second\n\trequestTimeout = 10 * time.Second\n\tbodyExcerpt    = 512\n)\n\n// ErrNoListener reports a configured port nothing is serving on.\nvar ErrNoListener = errors.New(\"no listener on the configured port\")\n\n// Suite is the registrar the suite's runner hands Register. Declared as a\n// one-method interface so this package compiles on its own and any runner\n// whose suite exposes Step satisfies it.\ntype Suite interface {\n\tStep(pattern string, fn func(*State, []string) error)\n}\n\n// State is the per-scenario state every definition in this package\n// shares: where the server under test answers, and what the last request\n// to it produced.\ntype State struct {\n\tServerName   string\n\tPort         int\n\tBaseURL      string\n\tStatusCode   int\n\tResponseBody []byte\n\tRequestErr   error\n}\n\n// NewState is what the suite's runner builds per scenario.\nfunc NewState() *State {\n\treturn &State{}\n}\n\n// Register lists every step wording this suite binds.\nfunc Register(suite Suite) {\n\tsuite.Step(`^the (.+) server is running on its configured port$`, givenServerRunning)\n\tsuite.Step(`^the (.+) posts a (valid|malformed) JSON-RPC ([A-Za-z0-9_/.-]+) request to (\\S+)$`, whenPostsJSONRPC)\n\tsuite.Step(`^the server returns HTTP ([0-9]{3})$`, thenServerReturnsStatus)\n}\n\n// givenServerRunning resolves the configured port and waits for it to\n// accept a connection, so a later When step posts at a real address.\nfunc givenServerRunning(state *State, args []string) error {\n\tname := args[0]\n\n\tport, err := configuredPort()\n\tif err != nil {\n\t\treturn err\n\t}\n\n\taddr := net.JoinHostPort(\"127.0.0.1\", strconv.Itoa(port))\n\tif err := waitForListener(addr); err != nil {\n\t\treturn fmt.Errorf(\"the %s server: %w\", name, err)\n\t}\n\n\tstate.ServerName = name\n\tstate.Port = port\n\tstate.BaseURL = \"http://\" + addr\n\n\treturn nil\n}\n\nfunc configuredPort() (int, error) {\n\traw := os.Getenv(portEnvVar)\n\tif raw == \"\" {\n\t\treturn defaultPort, nil\n\t}\n\n\tport, err := strconv.Atoi(raw)\n\tif err != nil {\n\t\treturn 0, fmt.Errorf(\"expected %s to hold a port number, got %q: %w\", portEnvVar, raw, err)\n\t}\n\n\treturn port, nil\n}\n\nfunc waitForListener(addr string) error {\n\tdeadline := time.Now().Add(bootTimeout)\n\tlastErr := ErrNoListener\n\n\tfor time.Now().Before(deadline) {\n\t\tconn, err := net.DialTimeout(\"tcp\", addr, dialTimeout)\n\t\tif err == nil {\n\t\t\t_ = conn.Close()\n\n\t\t\treturn nil\n\t\t}\n\n\t\tlastErr = err\n\n\t\ttime.Sleep(dialTimeout)\n\t}\n\n\treturn fmt.Errorf(\"expected something listening on %s within %s: %w\", addr, bootTimeout, lastErr)\n}\n\n// whenPostsJSONRPC posts the named JSON-RPC method to the given endpoint\n// and records the outcome for the Then clauses.\nfunc whenPostsJSONRPC(state *State, args []string) error {\n\trole, validity, method, path := args[0], args[1], args[2], args[3]\n\n\tif state.BaseURL == \"\" {\n\t\treturn fmt.Errorf(\"%s cannot post %s to %s: no server address was prepared — a Given step must run first\", role, method, path)\n\t}\n\n\tpayload, err := jsonRPCBody(validity, method)\n\tif err != nil {\n\t\treturn err\n\t}\n\n\tstate.StatusCode = 0\n\tstate.ResponseBody = nil\n\tstate.RequestErr = nil\n\n\tstatus, body, err := post(state.BaseURL+path, payload)\n\tif err != nil {\n\t\tstate.RequestErr = err\n\n\t\treturn nil\n\t}\n\n\tstate.StatusCode = status\n\tstate.ResponseBody = body\n\n\treturn nil\n}\n\nfunc post(url string, payload []byte) (int, []byte, error) {\n\treq, err := http.NewRequest(http.MethodPost, url, bytes.NewReader(payload))\n\tif err != nil {\n\t\treturn 0, nil, fmt.Errorf(\"building the POST to %s: %w\", url, err)\n\t}\n\n\treq.Header.Set(\"Content-Type\", \"application/json\")\n\treq.Header.Set(\"Accept\", \"application/json, text/event-stream\")\n\n\tclient := &http.Client{Timeout: requestTimeout}\n\n\tresp, err := client.Do(req)\n\tif err != nil {\n\t\treturn 0, nil, fmt.Errorf(\"posting to %s: %w\", url, err)\n\t}\n\tdefer func() { _ = resp.Body.Close() }()\n\n\tbody, err := io.ReadAll(resp.Body)\n\tif err != nil {\n\t\treturn 0, nil, fmt.Errorf(\"reading the response from %s: %w\", url, err)\n\t}\n\n\treturn resp.StatusCode, body, nil\n}\n\n// jsonRPCBody renders the request the step text asked for: a well-formed\n// envelope, or deliberately broken JSON when the step says \"malformed\".\nfunc jsonRPCBody(validity, method string) ([]byte, error) {\n\tif validity == \"malformed\" {\n\t\treturn []byte(`{\"jsonrpc\":`), nil\n\t}\n\n\tenvelope := map[string]any{\n\t\t\"jsonrpc\": \"2.0\",\n\t\t\"id\":      1,\n\t\t\"method\":  method,\n\t\t\"params\":  methodParams(method),\n\t}\n\n\tpayload, err := json.Marshal(envelope)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"marshalling the %s request: %w\", method, err)\n\t}\n\n\treturn payload, nil\n}\n\nfunc methodParams(method string) map[string]any {\n\tif method != \"initialize\" {\n\t\treturn map[string]any{}\n\t}\n\n\treturn map[string]any{\n\t\t\"protocolVersion\": \"2025-06-18\",\n\t\t\"capabilities\":    map[string]any{},\n\t\t\"clientInfo\": map[string]any{\n\t\t\t\"name\":    \"true-bdd-steps\",\n\t\t\t\"version\": \"0.1.0\",\n\t\t},\n\t}\n}\n\n// thenServerReturnsStatus asserts the recorded status, naming the status\n// it expected and whatever actually came back.\nfunc thenServerReturnsStatus(state *State, args []string) error {\n\twant, err := strconv.Atoi(args[0])\n\tif err != nil {\n\t\treturn fmt.Errorf(\"expected a numeric status in the step text, got %q: %w\", args[0], err)\n\t}\n\n\tif state.RequestErr != nil {\n\t\treturn fmt.Errorf(\"expec