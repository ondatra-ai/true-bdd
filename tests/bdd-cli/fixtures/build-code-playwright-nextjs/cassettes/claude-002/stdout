.0 -p 3000\\\",\\n    \\\"build\\\": \\\"next build\\\",\\n    \\\"start\\\": \\\"next start -H 0.0.0.0 -p 3000\\\"\\n  },\\n  \\\"dependencies\\\": {\\n    \\\"next\\\": \\\"^15.1.6\\\",\\n    \\\"react\\\": \\\"^19.0.0\\\",\\n    \\\"react-dom\\\": \\\"^19.0.0\\\"\\n  },\\n  \\\"devDependencies\\\": {\\n    \\\"@types/node\\\": \\\"^22.10.0\\\",\\n    \\\"@types/react\\\": \\\"^19.0.0\\\",\\n    \\\"@types/react-dom\\\": \\\"^19.0.0\\\",\\n    \\\"typescript\\\": \\\"^5.7.3\\\"\\n  }\\n}\\n```\\nNotes for the applier: do **not** hand-write a `package-lock.json`; the Dockerfile below uses `npm install`. The `-H 0.0.0.0 -p 3000` flags are required — the container port published by compose is `3000`, and binding to loopback only would make the published port unreachable from the host.\\n\\n### Change #2: Create the TypeScript config\\n**File:** `services/frontend/tsconfig.json`\\n**Action:** Use the **Write** tool (new file) with exactly this content. (The architecture quality gate declares this exact path at `architecture.services[frontend].quality_gate.code[typescript].config`, so the filename must match.)\\n**Content:**\\n```json\\n{\\n  \\\"compilerOptions\\\": {\\n    \\\"target\\\": \\\"ES2017\\\",\\n    \\\"lib\\\": [\\\"dom\\\", \\\"dom.iterable\\\", \\\"esnext\\\"],\\n    \\\"allowJs\\\": true,\\n    \\\"skipLibCheck\\\": true,\\n    \\\"strict\\\": true,\\n    \\\"noEmit\\\": true,\\n    \\\"esModuleInterop\\\": true,\\n    \\\"module\\\": \\\"esnext\\\",\\n    \\\"moduleResolution\\\": \\\"bundler\\\",\\n    \\\"resolveJsonModule\\\": true,\\n    \\\"isolatedModules\\\": true,\\n    \\\"jsx\\\": \\\"preserve\\\",\\n    \\\"incremental\\\": true,\\n    \\\"plugins\\\": [{ \\\"name\\\": \\\"next\\\" }],\\n    \\\"paths\\\": {\\n      \\\"@/*\\\": [\\\"./*\\\"]\\n    }\\n  },\\n  \\\"include\\\": [\\\"next-env.d.ts\\\", \\\"**/*.ts\\\", \\\"**/*.tsx\\\", \\\".next/types/**/*.ts\\\"],\\n  \\\"exclude\\\": [\\\"node_modules\\\"]\\n}\\n```\\n\\n### Change #3: Create the Next.js ambient type references\\n**File:** `services/frontend/next-env.d.ts`\\n**Action:** Use the **Write** tool (new file) with exactly this content.\\n**Content:**\\n```ts\\n/// <reference types=\\\"next\\\" />\\n/// <reference types=\\\"next/image-types/global\\\" />\\n```\\n\\n### Change #4: Create the Next.js config\\n**File:** `services/frontend/next.config.mjs`\\n**Action:** Use the **Write** tool (new file) with exactly this content.\\n**Content:**\\n```js\\n/** @type {import('next').NextConfig} */\\nconst nextConfig = {};\\n\\nexport default nextConfig;\\n```\\n\\n### Change #5: Create the App Router root layout\\n**File:** `services/frontend/app/layout.tsx`\\n**Action:** Use the **Write** tool (new file) with exactly this content. This is a server component (no `'use client'`), per the `component-composition` pattern in `docs/architecture/architecture.yaml` (\\\"Use server components by default\\\").\\n**Content:**\\n```tsx\\nimport type { Metadata } from 'next';\\nimport type { ReactNode } from 'react';\\n\\nexport const metadata: Metadata = {\\n  title: 'Frontend',\\n  description: 'Frontend service',\\n};\\n\\nexport default function RootLayout({ children }: { children: ReactNode }) {\\n  return (\\n    <html lang=\\\"en\\\">\\n      <body>{children}</body>\\n    </html>\\n  );\\n}\\n```\\n\\n### Change #6: Create the home page that satisfies the assertion\\n**File:** `services/frontend/app/page.tsx`\\n**Action:** Use the **Write** tool (new file) with exactly this content. The page must render **exactly one** `h1` whose text content is exactly `Hello world` — `page.locator('h1')` is strict-mode and `toHaveText('Hello world')` compares the full normalized text, so do not add extra `h1` elements, suffixes, punctuation, or emoji.\\n**Content:**\\n```tsx\\nexport default function HomePage() {\\n  return (\\n    <main>\\n      <h1>Hello world</h1>\\n    </main>\\n  );\\n}\\n```\\n\\n### Change #7: Create the Dockerfile that compose builds\\n**Fil