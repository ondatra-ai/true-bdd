ts\\\", \\\"**/*.tsx\\\", \\\".next/types/**/*.ts\\\"],\\n  \\\"exclude\\\": [\\\"node_modules\\\"]\\n}\\n```\\n\\n### Change #4: Root layout (App Router requires it)\\n**File:** `services/frontend/app/layout.tsx`\\n**Action:** Write (new file).\\n**Content:**\\n```tsx\\nimport type { Metadata, Viewport } from 'next';\\nimport type { ReactNode } from 'react';\\n\\nexport const metadata: Metadata = {\\n  title: 'Frontend',\\n  description: 'Frontend service',\\n};\\n\\nexport const viewport: Viewport = {\\n  width: 'device-width',\\n  initialScale: 1,\\n};\\n\\nexport default function RootLayout({ children }: { children: ReactNode }) {\\n  return (\\n    <html lang=\\\"en\\\">\\n      <body>{children}</body>\\n    </html>\\n  );\\n}\\n```\\n\\n### Change #5: Home page — the asserted `<h1>`\\n**File:** `services/frontend/app/page.tsx`\\n**Action:** Write (new file).\\n**Content:**\\n```tsx\\nexport default function HomePage() {\\n  return (\\n    <main>\\n      <h1>Hello world</h1>\\n    </main>\\n  );\\n}\\n```\\nNotes for the applier: this is a server component (no `'use client'`), per the\\n`component-composition` pattern in `docs/architecture/architecture.yaml`. The\\n`<h1>` text must be exactly `Hello world` — `toHaveText` is an exact (trimmed)\\nmatch, so do not add extra visible text inside the `h1`, and keep exactly one\\n`h1` on the page so `page.locator('h1')` resolves to a single element.\\n\\n### Change #6: Container image used by docker-compose\\n**File:** `services/frontend/Dockerfile`\\n**Action:** Write (new file).\\n**Content:**\\n```dockerfile\\nFROM node:20-alpine\\n\\nWORKDIR /app\\n\\nENV NEXT_TELEMETRY_DISABLED=1\\nENV NODE_ENV=development\\n\\nCOPY package.json ./\\nRUN npm install\\n\\nCOPY . .\\n\\nRUN npm run build\\n\\nENV NODE_ENV=production\\nEXPOSE 3000\\n\\nCMD [\\\"npm\\\", \\\"run\\\", \\\"start\\\"]\\n```\\nNotes for the applier:\\n- There is no lockfile, so `npm install` (not `npm ci`) is required.\\n- `NODE_ENV=development` during i