 state.Value *= 2; return nil
}
func number(state *State, args []string) error {
```

### Change #3: Remove the value-specific hack from the Given step and fail honestly on a bad number

**File:** `tests/calc/steps/steps.go`
**Action:** Use the Edit tool to replace the body of `number`. Drop `if value == 3 { state.Value++ }` entirely, and return a named error on parse failure instead of assigning first and returning the bare error.

**old_string** (verbatim — note the single leading space of indentation):
```
 value, err := strconv.Atoi(args[0]); state.Value = value; if value == 3 { state.Value++ }; return err
```

**new_string:**
```
 value, err := strconv.Atoi(args[0])
 if err != nil { return fmt.Errorf("expected the number to be an integer, got %q", args[0]) }
 state.Value = value; return nil
```

