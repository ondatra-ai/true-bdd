id: "96.8"
title: "Document Summary On Demand"
as_a: "Claude User"
i_want: "Claude to give me a short summary of a shared Google Doc when I ask for one"
so_that: "I can decide whether the document needs my attention without reading it in full"
status: "PLANNED"
acceptance_criteria:
  - id: "AC-1"
    description: "Claude must display a summary of 150 words or fewer in the conversation when the Claude User asks for a summary of a shared Google Doc."
    steps:
      - given:
          - "a Google Doc with at least 500 words of body text is shared with the Claude User's account"
      - when:
          - "the Claude User asks Claude to summarize the document"
      - then:
          - "Claude displays a summary of 150 words or fewer in the conversation"
  - id: "AC-2"
    description: "Claude must display the message 'This document is not shared with your account' when the Claude User asks for a summary of a document they cannot access."
    steps:
      - given:
          - "a Google Doc is not shared with the Claude User's account"
      - when:
          - "the Claude User asks Claude to summarize the document"
      - then:
          - "Claude displays the message 'This document is not shared with your account' in the conversation"
  - id: "AC-3"
    description: "Claude must display the message 'The summary timed out - please try again' when no summary is produced within 30 seconds of the Claude User asking for a summary."
    steps:
      - given:
          - "a Google Doc is shared with the Claude User's account"
      - when:
          - "the Claude User asks Claude to summarize the document and no summary is produced within 30 seconds"
      - then:
          - "Claude displays the message 'The summary timed out - please try again' in the conversation"
  - id: "AC-4"
    description: "Claude must state that only the first 10000 words were summarized when the shared Google Doc contains more than 10000 words."
    steps:
      - given:
          - "a Google Doc containing more than 10000 words is shared with the Claude User's account"
      - when:
          - "the Claude User asks Claude to summarize the document"
      - then:
          - "Claude displays a summary and states that only the first 10000 words were summarized"
