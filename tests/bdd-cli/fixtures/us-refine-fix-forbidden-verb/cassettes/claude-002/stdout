ne acceptance_criteria vague-word prompts.\n46\t  forbidden_qualifiers:\n47\t    - properly\n48\t    - correctly\n49\t    - appropriate\n50\t    - appropriately\n51\t    - user-friendly\n52\t    - fast\n53\t    - quickly\n54\t    - easily\n55\t    - seamless\n56\t    - intuitive\n57\t\n58\t  # Action verbs too abstract to automate: they hide the interaction\n59\t  # mechanism. Checked by the us-refine forbidden-verb prompt.\n60\t  forbidden_actions:\n61\t    - name: \"handle\"\n62\t      reason: \"Hides what the system observably does with the input.\"\n63\t      replacement: \"Name the observable action: displays, returns, lists, rejects.\"\n64\t    - name: \"process\"\n65\t      reason: \"Does not specify the interaction mechanism or the visible outcome.\"\n66\t      replacement: \"Name the observable action: displays, returns, lists, rejects.\"\n67\t    - name: \"parse\"\n68\t      reason: \"Describes internal mechanics, not user-observable behavior.\"\n69\t      replacement: \"Describe the visible result of reading the input.\"\n70\t"}]},"parent_tool_use_id":null,"session_id":"d42df8c9-41f7-48df-a49a-1ef540a661d5","uuid":"8c08cd80-9f97-4697-8f64-c8e9566eb0fb","timestamp":"2026-08-31T22:40:31.594Z","tool_use_result":{"type":"text","file":{"filePath":"docs/architecture/architecture.yaml","content":"# Architectural spec for the us-refine BDD fixtures (shared).\n#\n# Read by the us-refine acceptance_criteria test-sketch prompt, which\n# must discover the test framework and helpers HERE (never from code).\n# Declares one integration layer (jest + McpClient) and one e2e layer\n# (playwright + chatPage) so every conversation-level AC has an obvious\n# home for a runnable sketch.\n\narchitecture:\n  services:\n    - name: mcp-service\n      path: services/mcp\n      language: go\n      frameworks:\n        - net/http\n      quality_gate:\n        tests:\n          integration:\n            path: tests/integration\n            framework: jest\n            config: tests/j