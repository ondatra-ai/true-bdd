# Copy to .env (gitignored) and fill in the keys for the backends you use.
# start.sh reads this file. Standard/Anthropic mode needs nothing here.

# --- Z.AI (GLM) -------------------------------------------------------------
# Key: https://z.ai/manage-apikey/apikey-list
ZAI_API_KEY=
# Optional overrides (default: auto-map to current GLM on Z.AI's side):
# ZAI_BASE_URL=https://api.z.ai/api/anthropic
# ZAI_OPUS_MODEL=glm-4.7
# ZAI_SONNET_MODEL=glm-4.7
# ZAI_HAIKU_MODEL=glm-4.5-air

# --- Kimi (Moonshot K2) -----------------------------------------------------
# Key: https://platform.moonshot.ai/  (starts with sk-)
KIMI_API_KEY=
# Optional overrides:
# KIMI_BASE_URL=https://api.moonshot.ai/anthropic   # use api.moonshot.cn in China
# KIMI_OPUS_MODEL=kimi-k2-turbo-preview
# KIMI_SONNET_MODEL=kimi-k2-turbo-preview
# KIMI_HAIKU_MODEL=kimi-k2-turbo-preview

# --- Shared -----------------------------------------------------------------
# API_TIMEOUT_MS=3000000
