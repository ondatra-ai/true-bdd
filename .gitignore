# Binaries
/bin/
*.exe
*.test
*.out
/coverage

# Build / test artefacts
/tmp/
/dist/
/node_modules/

# Web harness (Next.js) — dependencies, build output, runtime data,
# and Playwright artefacts
/harness/node_modules/
/harness/.next/
/harness/data/
/harness/playwright-report/
/harness/test-results/
/harness/*.tsbuildinfo
/harness/next-env.d.ts

# Web harness source is GENERATED code (Spec-as-Source): the e2e suite under
# tests/harness/ is the spec, and ALL harness production code + unit tests are
# regeneratable from it. Everything implement-task writes lives under the single
# /harness/src/ root (see docs/context/paths.yaml → harness_code_root). Working
# copies stay on disk but are never tracked.
/harness/src/

# Self-contained Playwright E2E suite (tests/harness) — deps + artefacts
/tests/harness/node_modules/
/tests/harness/test-results/
/tests/harness/playwright-report/
/tests/harness/.tmp/

# Conversation history captured by .claude/hooks/history.py
/docs/history/
coverage.txt
coverage.out

# Editor / OS
.DS_Store
.idea/
.vscode/

# Python bytecode (Claude hooks)
__pycache__/

# Playwright MCP server artefacts (console/page logs)
.playwright-mcp/

# Local secrets and environment overrides
.env
.env.local

# Design gold-standard screenshots (tests/harness/goldens, incl. the
# per-component crops/ subdir) MUST be tracked — the user-level
# ~/.gitignore_global ignores *.png, so re-include them here.
!tests/harness/goldens/**/*.png
