# Binaries
/bin/
*.exe
*.test
*.out
/coverage

# Build / test artefacts
/tmp/
/dist/
/node_modules/

# Web harness (Next.js) — dependencies, build output, runtime data,
# and Playwright artefacts
/harness/node_modules/
/harness/.next/
/harness/data/
/harness/playwright-report/
/harness/test-results/
/harness/tests/**/.tmp/
/harness/*.tsbuildinfo
/harness/next-env.d.ts

# Web harness source under /harness/app/ is now the tracked production app
# (rebuilt by implement-task: test-author scaffolding + coder pages/api routes;
# see docs/context/paths.md "Production code"). /harness/tests/ is now the
# coder's tracked Vitest unit-test tree (see paths.md "Unit tests");
# components/lib stay ignored until the coder rebuilds them.
/harness/components/
/harness/lib/

# Self-contained Playwright E2E suite (tests/harness) — deps + artefacts
/tests/harness/node_modules/
/tests/harness/test-results/
/tests/harness/playwright-report/
/tests/harness/.tmp/

# Conversation history captured by .claude/hooks/history.py
/docs/history/
coverage.txt
coverage.out

# Editor / OS
.DS_Store
.idea/
.vscode/

# Python bytecode (Claude hooks)
__pycache__/

# Playwright MCP server artefacts (console/page logs)
.playwright-mcp/

# Local backend secrets for start.sh
.env
.env.local
